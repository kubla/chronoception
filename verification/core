#!/bin/bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/chronoception-core.XXXXXX")
trap 'rm -rf "$work"' EXIT
cd "$root"
python3 verification/generate_project.py --check
xcrun swift-format lint --strict --configuration .swift-format --recursive Shared Application UITests verification/HouseStyle.swift verification/render_icon.swift
verification/house-style
swift test --package-path Shared --scratch-path "$work/build"
